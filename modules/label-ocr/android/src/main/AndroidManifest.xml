<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!--
      Asks Play Services to fetch the OCR model when the app is installed
      rather than on first scan. Without this the model downloads lazily, and
      the very first label a user tries to read is the one that fails or stalls
      while it arrives - which for this audience is the moment they conclude
      the app does not work.
    -->
    <meta-data
      android:name="com.google.mlkit.vision.DEPENDENCIES"
      android:value="ocr" />
  </application>
</manifest>
